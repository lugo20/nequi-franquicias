{
  "info": {
    "name": "nequi-franquicias",
    "description": "API de franquicias. Ejecutar en orden: la carpeta 1 crea los datos y guarda los ids en variables; la carpeta 2 usa esos ids para probar los errores.\n\nVariable baseUrl: URL de AWS por defecto; para local usar http://localhost:8080/api/v1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Flujo completo",
      "item": [
        {
          "name": "1. Crear franquicia",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique suffix: franchise names are unique system-wide.",
                  "pm.collectionVariables.set(\"suffix\", Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"franchiseId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/franchises/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises",
                "create"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cafe Express {{suffix}}\"\n}"
            },
            "description": "Crea la franquicia y guarda su id en la variable franchiseId."
          }
        },
