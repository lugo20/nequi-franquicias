                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const top = pm.response.json();",
                  "pm.test(\"Un producto por sucursal\", () => pm.expect(top.length).to.eql(2));",
                  "pm.test(\"Norte -> Cafe (10)\", () => pm.expect([top[0].branchName, top[0].productName, top[0].stock]).to.eql([\"Norte\", \"Cafe\", 10]));",
                  "pm.test(\"Sur -> Pastel (7)\", () => pm.expect([top[1].branchName, top[1].productName, top[1].stock]).to.eql([\"Sur\", \"Pastel\", 7]));"
                ]
